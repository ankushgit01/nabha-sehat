# App env (EXPO_PUBLIC_* values are embedded in the JS bundle — never put secrets here).
EXPO_PUBLIC_API_URL=https://api.example.org
# js (default, pure-TypeScript model) | tflite (react-native-fast-tflite, needs dev client)
EXPO_PUBLIC_TRIAGE_ENGINE=js
# 1 = encrypt SQLite with SQLCipher (also set useSQLCipher in the expo-sqlite plugin)
EXPO_PUBLIC_SQLCIPHER=0
# Set as EAS secrets, not here: EAS_PROJECT_ID, GOOGLE_MAPS_ANDROID_KEY
