{
  "name": "nabha-telemedicine-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production tsx src/main.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "multer": "^2.0.0",
    "pino-http": "^10.4.0",
    "twilio": "^5.8.0",
    "zod": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^10.1.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
