# Copy to .env (never commit .env). In production set these as platform secrets.
PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nabha
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30d
CORS_ORIGINS=https://app.example.org,http://localhost:8081

# Twilio Verify (OTP) + Messaging (facility SOS alerts). If unset and NODE_ENV!=production,
# OTP codes are logged to the console for local development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
FACILITY_ALERT_NUMBERS=

# Phone numbers allowed to log in with the doctor role (comma-separated, E.164)
DOCTOR_PHONES=
